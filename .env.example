# PostgreSQL (e.g. Neon). Required for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/facturear?schema=public"

# Used for local file URLs when not using S3 (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL canónica pública para SEO (canonical, sitemap, robots, Open Graph). Default:
# https://www.agilescan.com.ar — los previews de Vercel también apuntan a producción a propósito.
# NEXT_PUBLIC_SITE_URL=https://www.agilescan.com.ar

# Conexión DIRECTA (sin pooler) para `prisma migrate` en el build de producción
# (scripts/migrate-on-deploy.mjs). La integración Neon ↔ Vercel la define sola; en Neon es
# la URL sin "-pooler" en el host. No hace falta en local.
# DATABASE_URL_UNPOOLED=

# Auth.js / NextAuth v5 — must be a long random string (signs the session JWT).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set as AUTH_SECRET=... below. (Do not use plain `npx auth secret` — npm may install
# Better Auth and suggest BETTER_AUTH_SECRET; this app also reads BETTER_AUTH_SECRET if present.)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# SMTP (registro con activación manual por código)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AgileScan <noreply@agilescan.com.ar>"
REGISTRATION_NOTIFY_EMAIL=info@agilescan.com.ar

# --- AWS S3 (opcional en local). En Vercel: las 4 variables O solo DATABASE_URL (archivos en Neon) ---
# Nombres exactos; bucket solo el nombre (ej. mi-bucket), sin s3://
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Alias aceptado en Vercel si ya creaste S3_BUCKET_NAME:
# S3_BUCKET_NAME=

# OpenAI
OPENAI_API_KEY=
# Modelo de extracción. Default: gpt-6-luna (pipeline v2, src/lib/extraction-v2).
OPENAI_MODEL=gpt-6-luna
# Pipeline de extracción: v2 (default; QR de ARCA + 1 llamada + validación + maestro de proveedores)
# o legacy (varias pasadas pensadas para gpt-4o). Vuelta atrás rápida sin deploy.
# EXTRACTION_PIPELINE=v2
# Solo para modelos con razonamiento (gpt-5.x, gpt-6-*, o*): low | medium | high. Default: medium.
# Con estos modelos no se envía `temperature` (lo rechazan con HTTP 400).
# OPENAI_REASONING_EFFORT=medium
# Páginas máximas que se envían a visión por PDF escaneado (si hay más: primeras N-1 + la última).
# PDF_VISION_MAX_PAGES=6
